# /etc/task-flow/api.env 예시 (T13). 실제 파일은 root 소유·권한 600으로 두고 Git에 올리지 않는다.
# DB_HOST는 T12에서 구성한 DB 서버 주소로 바꾼다.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=task_flow
DB_USER=task_flow_app
DB_PASSWORD=change-me
# API가 접속을 받을 주소·포트. 127.0.0.1은 이 서버 안에서만 접속 가능하다.
# T14에서 Web 서버의 Nginx가 접속해야 하면 App 서버의 사설 IP로 바꾸고 방화벽으로 Web 서버만 허용한다.
APP_HOST=127.0.0.1
APP_PORT=8000
